{
    "extensions": [
      "js","ts","jsx","tsx","html","css","json","md","yml","yaml"
    ],
    "tagPatterns": [
      "//#PL:.*?#\\/",
      "/\\*.*?//#PL:.*?#\\/.*?\\*/",
      "\\{\\/\\*.*?//#PL:.*?#\\/.*?\\*\\/\\}",
      "<!--.*?//#PL:.*?#\\/.*?-->"
    ],
    "emptyCommentPatterns": [
      "/\\*\\s*\\*/",
      "\\{\\s*\\}",
      "<!--\\s*-->"
    ]
  }
  